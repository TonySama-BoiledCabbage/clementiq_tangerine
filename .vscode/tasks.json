{
  "version": "2.0.0",
  "tasks": [
    { "label": "API: run (port 8000)", "type": "shell", "command": "${workspaceFolder}/services/api/.venv/Scripts/python -m uvicorn clementiq.main:app --reload --port 8000", "options": { "cwd": "${workspaceFolder}/services/api" }, "isBackground": true, "problemMatcher": [] },
    { "label": "Web: dev (port 3000)", "type": "shell", "command": "npm run dev:web", "isBackground": true, "problemMatcher": [] },
    { "label": "Worker: run", "type": "shell", "command": "${workspaceFolder}/services/api/.venv/Scripts/python ../worker/worker.py", "options": { "cwd": "${workspaceFolder}/services/api" }, "isBackground": true, "problemMatcher": [] },
    { "label": "Data: import CSVs", "type": "shell", "command": "${workspaceFolder}/services/api/.venv/Scripts/python -m clementiq.cli import", "options": { "cwd": "${workspaceFolder}/services/api" }, "problemMatcher": [] },
    { "label": "Tests: backend", "type": "shell", "command": "${workspaceFolder}/services/api/.venv/Scripts/python -m pytest -q", "options": { "cwd": "${workspaceFolder}/services/api" }, "group": "test", "problemMatcher": [] },
    { "label": "ClementIQ: start all", "type": "shell", "command": "npm run dev", "isBackground": true, "problemMatcher": [] },
    { "label": "ClementIQ: stop (free ports 8000/3000)", "type": "shell", "command": "npm run stop", "problemMatcher": [] }
  ]
}
